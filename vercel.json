{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/partners.js": { "maxDuration": 30 },
    "api/legacy.js": { "maxDuration": 30 },
    "api/reports.js": { "maxDuration": 30 },
    "api/merchants.js": { "maxDuration": 30 },
    "api/ai-import.js": { "maxDuration": 60 },
    "api/security-check.js": { "maxDuration": 60 },
    "api/cron-security-check.js": { "maxDuration": 60 },
    "api/scheduled-reports.js": { "maxDuration": 60 },
    "api/email-log.js": { "maxDuration": 30 },
    "api/cron-daily-report.js": { "maxDuration": 60 },
    "api/cron-weekly-report.js": { "maxDuration": 60 },
    "api/cron-monthly-report.js": { "maxDuration": 60 },
    "api/cron-alerts.js": { "maxDuration": 60 },
    "api/cron-task-digest.js": { "maxDuration": 60 },
    "api/cron-youtube-sync.js": { "maxDuration": 60 },
    "api/cron-youtube-comments.js": { "maxDuration": 60 },
    "api/cron-youtube-livechat.js": { "maxDuration": 60 },
    "api/youtube-oauth.js": { "maxDuration": 60 },
    "api/ghl-documents.js": { "maxDuration": 30 },
    "api/cron-award-certificates.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron-award-certificates",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron-security-check",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron-daily-report",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron-weekly-report",
      "schedule": "0 * * * 1"
    },
    {
      "path": "/api/cron-monthly-report",
      "schedule": "0 * 1 * *"
    },
    {
      "path": "/api/cron-alerts",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron-task-digest",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron-youtube-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron-youtube-comments",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron-youtube-livechat",
      "schedule": "* * * * *"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/go/(.*)", "dest": "/api/qr-redirect?c=$1" },
    { "src": "/p/(.*)", "dest": "/landing.html" },
    { "src": "/bug-report\\.js", "dest": "/bug-report.js" },
    { "src": "/partner/dashboard", "dest": "/partner/dashboard.html" },
    { "src": "/partner/merchants", "dest": "/partner/merchants.html" },
    { "src": "/partner/pos-lead", "dest": "/partner/pos-lead.html" },
    { "src": "/partner/messages", "dest": "/partner/messages.html" },
    { "src": "/partner/community", "dest": "/partner/community.html" },
    { "src": "/partner/settings", "dest": "/partner/settings.html" },
    { "src": "/partner/profile", "dest": "/partner/profile.html" },
    { "src": "/partner/certificate", "dest": "/partner/certificate.html" },
    { "src": "/partner/leaderboard", "dest": "/partner/leaderboard.html" },
    { "src": "/partner", "dest": "/partner/index.html" },
    { "src": "/partner/", "dest": "/partner/index.html" },
    { "src": "/lead", "dest": "/lead/register.html" },
    { "src": "/lead/", "dest": "/lead/register.html" },
    { "src": "/lead/(.*)", "dest": "/lead/$1.html" },
    { "src": "/(.*)\\.html", "dest": "/$1.html" },
    { "src": "/(.*)", "dest": "/$1.html" }
  ]
}
